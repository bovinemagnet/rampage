flowchart TD

    %% ──────────────────────────────────────────────
    %% PATH A — inline string references: resolve(ref)
    %% ──────────────────────────────────────────────
    subgraph PathA["Path A — inline reference: resolve(ref)"]
        A1["resolve(ref)"]
        A2{"ref is null?"}
        A3[Return null]
        A4{"starts with 'ENV:'?"}
        A5["Read env var by name"]
        A6{"env var set?"}
        A7["Track as sensitive<br/>Return value"]
        A8{"starts with 'SM:'?"}
        A9["Return '***REDACTED***'<br/>(Secret Manager stub)"]
        A10["Return literal string<br/>unchanged"]
        A_THROW["THROW SecretResolutionException<br/>'ENV:' reference — env var not set"]

        A1 --> A2
        A2 -- Yes --> A3
        A2 -- No --> A4
        A4 -- Yes --> A5
        A5 --> A6
        A6 -- SET --> A7
        A6 -- UNSET --> A_THROW
        A4 -- No --> A8
        A8 -- Yes --> A9
        A8 -- No --> A10
    end

    %% ──────────────────────────────────────────────
    %% PATH B — structured credentials / tokens
    %% resolveCredential(cred, path) / resolveToken(token, path)
    %% ──────────────────────────────────────────────
    subgraph PathB["Path B — structured config: resolveCredential / resolveToken<br/>(both share this logic; each config carries a 'required' flag, default true)"]
        B1["resolveCredential(cred, path)<br/>resolveToken(token, path)"]
        B2{"source == 'env'?"}

        B3{"envVar null<br/>or blank?"}
        B4{"required?"}
        B5["THROW SecretResolutionException<br/>source 'env' but no envVar set"]
        B6["Return ''"]

        B7["Read env var by name"]
        B8{"env var set?"}
        B9{"required?"}
        B10["THROW SecretResolutionException<br/>named env var not set"]
        B11["Log warning<br/>Return ''"]
        B12["Track as sensitive<br/>Return value"]

        B13{"source ==<br/>'secret-manager' or 'sm'?"}
        B14{"secretPath null<br/>or blank?"}
        B15["THROW SecretResolutionException<br/>secret-manager but no secretPath set"]
        B16["Return '***REDACTED***'<br/>(Secret Manager stub)"]

        B17{"source == 'plain'<br/>or unrecognised?"}
        B18["Log warning for<br/>unrecognised source"]
        B19["Track as sensitive<br/>Return value"]

        B1 --> B2
        B2 -- Yes --> B3
        B3 -- Yes --> B4
        B4 -- required --> B5
        B4 -- not required --> B6
        B3 -- No --> B7
        B7 --> B8
        B8 -- SET --> B12
        B8 -- UNSET --> B9
        B9 -- required --> B10
        B9 -- not required --> B11
        B2 -- No --> B13
        B13 -- Yes --> B14
        B14 -- Yes --> B15
        B14 -- No --> B16
        B13 -- No --> B17
        B17 -- unrecognised --> B18
        B18 --> B19
        B17 -- plain --> B19
    end

    %% ──────────────────────────────────────────────
    %% Shared outcome note — fail-fast guarantee
    %% ──────────────────────────────────────────────
    OUTCOME["SecretResolutionExceptions are aggregated by ConfigValidator<br/>validateLoadTest exits non-zero<br/>RampageSimulation halts BEFORE any traffic is generated"]

    A_THROW --> OUTCOME
    B5 --> OUTCOME
    B10 --> OUTCOME
    B15 --> OUTCOME

    %% ──────────────────────────────────────────────
    %% Styling — highlight throw nodes and the outcome
    %% ──────────────────────────────────────────────
    style A_THROW fill:#c0392b,color:#fff,stroke:#7b241c,stroke-width:2px
    style B5     fill:#c0392b,color:#fff,stroke:#7b241c,stroke-width:2px
    style B10    fill:#c0392b,color:#fff,stroke:#7b241c,stroke-width:2px
    style B15    fill:#c0392b,color:#fff,stroke:#7b241c,stroke-width:2px
    style OUTCOME fill:#1a252f,color:#ecf0f1,stroke:#2c3e50,stroke-width:2px
    style B4     fill:#d68910,color:#fff,stroke:#9a6412,stroke-width:2px
    style B9     fill:#d68910,color:#fff,stroke:#9a6412,stroke-width:2px
